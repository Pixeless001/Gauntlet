{
  "name": "gauntlet-agent",
  "version": "1.0.4",
  "description": "A lightweight control layer for clean, verified coding-agent workflows",
  "type": "module",
  "main": "dist/src/cli.js",
  "bin": { "gauntlet": "dist/src/cli.js" },
  "files": ["dist/src", "skills", "commands", "hooks", ".codex-plugin", ".claude-plugin", "LICENSE"],
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "smoke:install": "node scripts/install-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "substrate:probe": "node scripts/substrate-probe.mjs",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [],
  "author": "Pixeless001",
  "license": "MIT",
  "dependencies": {
    "picocolors": "^1.1.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
