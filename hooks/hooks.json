{
  "description": "Gauntlet task steering, activity tracking, and finish verification.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/dist/src/cli.js\" hook auto",
            "timeout": 10,
            "additionalContextLimit": 1500
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/dist/src/cli.js\" hook auto",
            "timeout": 5,
            "additionalContextLimit": 800
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/dist/src/cli.js\" hook auto",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
